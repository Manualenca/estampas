# Copiar como .env y completar. El archivo .env no se sube al repositorio.
# Para generarlo con una clave nueva, seguir los pasos del README.
SECRET_KEY='poner-aca-una-clave-larga-y-aleatoria'

# La base va fuera de OneDrive. Los backups quedan en la subcarpeta backups.
DB_PATH='C:\EstampasDatos\db.sqlite3'

# Opcional: carpeta donde se copia además el último backup (se conservan los últimos 7).
# Si la carpeta no existe, el backup principal se hace igual y el problema queda en backups.log.
BACKUP_EXTRA_DIR=''
